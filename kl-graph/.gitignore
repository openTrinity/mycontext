# Data (generated by ingestion pipeline)
data/

# DWS export output (generated by tools\dws.exe)
dws_export/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Survey / research notes (local only)
survey/

# Experiments and evaluation datasets (local only)
experiments/
locomo/
*.zip

# AgentKit runtime state (session-specific)
.agentkit/

# AI assistant local files (not tracked)
CLAUDE.md
.claude/

# Local runtime config with secrets — never commit
.env
config.yaml
scripts/live_env.sh

# DWS CLI binary and auth/config (proprietary, org-specific)
tools/dws.exe
tools/.dws/
.venv
