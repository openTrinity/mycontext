# MyContext 本地环境变量示例
# 复制为 .env 后按需修改；.env 不会提交到 git。
# 优先级：内置默认 < .env（仅开发态） < 真实环境变量

# 日志级别：debug | info | warn | error
MYCONTEXT_LOG_LEVEL=info

# 开发态覆盖数据目录（留空则用系统默认 userData 目录）
MYCONTEXT_DATA_DIR=

# 是否自动打开开发者工具：0 | 1
MYCONTEXT_DEV_TOOLS=0

# 开发服务器端口（renderer 的 Vite dev server）。
# 刻意不用 Vite 默认的 5173：本机同时跑多个 Vite 项目时必然相撞。
# 端口被占用时会直接报错而不是静默换端口（避免主进程连不上导致白屏）。
MYCONTEXT_DEV_PORT=5273

# ---------------------------------------------------------------
# 以下为后续阶段（模型接入）预留。
# 当前阶段只验证「注入是否生效」与「密钥是否脱敏」，不会发起任何网络请求。
# ---------------------------------------------------------------

# 模型网关（OpenAI 兼容）
MYCONTEXT_LLM_BASE_URL=https://llmapi.llm-gateway.com
MYCONTEXT_LLM_API_KEY=

# 默认模型
MYCONTEXT_MODEL_MAIN=glm-5.2
MYCONTEXT_EMBED_MODEL=text-embedding-v4

# ---------------------------------------------------------------
# KL（知识图谱）建索引专用网关（可选）
# ---------------------------------------------------------------
#
# 留空则**回退主配置**（上面那套）。只有想给知识图谱抽取单独指一个
# 网关/密钥/模型时才填 —— 它抽取走 Anthropic 模式，历史上换主模型时
# 曾把中文抽取一起换坏，所以留了这条独立口。
# MYCONTEXT_KL_LLM_BASE_URL=
# MYCONTEXT_KL_LLM_API_KEY=
# MYCONTEXT_KL_MODEL_MAIN=

# ---------------------------------------------------------------
# 搜索模块的 Agent（opencode）
# ---------------------------------------------------------------
#
# 搜索页的答案由 opencode agent 编排生成。它**复用上面那一套网关配置**
# （`MYCONTEXT_LLM_BASE_URL` + `MYCONTEXT_LLM_API_KEY`）—— 同一个网关，
# 不需要为搜索再配一遍。
#
# 只有一种情况需要下面这些：想给搜索**单独**指一个网关/密钥
# （比如临时换个模型服务）。它们的优先级高于 MYCONTEXT_LLM_*。
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# 搜索 agent 用的模型（可选，默认 claude-sonnet-4-6）
# MYCONTEXT_SEARCH_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------
# 钉钉 CLI（dws）—— 两项都**留空即可**，绝大多数情况不用配。
# 也可以在应用 UI 上填（渠道授权卡片里的「使用自有 dws」折叠区）。
# 优先级：UI 上填的 > 这里 > 随应用分发的开源版。
# ---------------------------------------------------------------

# 自备 dws 可执行文件（或它所在的目录）。留空 = 用随应用分发的开源版。
# 内部同学用闭源版时把路径填在这里，`pnpm prepare:bin` 与应用运行时都认。
MYCONTEXT_DWS_SOURCE=

# 渠道号（上游 channelCode）。留空 = 不发那个请求头，绝大多数组织都可用。
# 只有组织把 CLI 访问限定到特定渠道时才需要填（否则授权阶段会报
# CHANNEL_NOT_ALLOWED，有明确提示）。它与自备 dws 内置的身份配套，
# 所以只在用了自备 dws 时才生效。
MYCONTEXT_DWS_CHANNEL=
